# The application expects externally managed Railway/PostgreSQL/Stripe secrets.
PORT=8080
NODE_ENV=production
BASE_URL=https://signalforge-web-production.up.railway.app
# DATABASE_URL=postgresql://<secret> (set in Railway; NEVER commit it)
# SIGNALFORGE_COMPANY_OS_KEY=<long random service key> (set in Railway)
# SIGNALFORGE_ADMIN_EMAIL=<verified admin email> (set in Railway)
# STRIPE_WEBHOOK_SECRET=<secret> (set in Railway)
# SIGNALFORGE_STRIPE_*_PRICE / *_URL (set in Railway)
# DATABASE_SSL=disable is permitted only when NODE_ENV=test (local disposable database).
