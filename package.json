{
  "name": "@noetfield/signalforge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SignalForge market intelligence, premium community and governed Company OS read-only telemetry",
  "scripts": {
    "start": "bun run src/server.ts",
    "dev": "bun --watch src/server.ts",
    "check": "bun build src/server.ts --target=bun --external=postgres --outfile=/tmp/signalforge-build-check.js",
    "test": "bun test tests",
    "forecast": "bun run scripts/forecast.ts"
  },
  "dependencies": {
    "postgres": "3.4.5"
  }
}
